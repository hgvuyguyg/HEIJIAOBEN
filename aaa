local COLOR_WHITE      = Color3.fromRGB(255, 255, 255)
local COLOR_LIGHT_BLUE = Color3.fromRGB(173, 216, 230)
local COLOR_PINK       = Color3.fromRGB(255, 182, 193)
local COLOR_POOL = { COLOR_WHITE, COLOR_LIGHT_BLUE, COLOR_PINK }

local BIG_ORB_TARGET = 2

local function getEdgeDistance(nx, ny)
	local dLeft, dRight = nx, 1 - nx
	local dBottom, dTop = 1 - ny, ny
	local minDist = math.min(dLeft, dRight, dBottom, dTop)
	return math.clamp(minDist / 0.5, 0, 1)
end

local function tintColor(color, factor)
	return Color3.new(
		math.clamp(color.R * factor, 0, 1),
		math.clamp(color.G * factor, 0, 1),
		math.clamp(color.B * factor, 0, 1)
	)
end

local function createOrb(px, py, baseSize, forceEdge, isBig)
	local orb = Instance.new("Frame")
	orb.Name = "Orb"
	orb.BorderSizePixel = 0
	orb.ZIndex = 1

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(1, 0)
	corner.Parent = orb

	orb.Size = UDim2.new(0, baseSize, 0, baseSize)
	orb.Position = UDim2.new(px, 0, py, 0)
	orb.AnchorPoint = Vector2.new(0.5, 0.5)

	local edgeFactor = forceEdge and 0 or getEdgeDistance(px, py)
	local baseColor = COLOR_POOL[math.random(1, #COLOR_POOL)]
	local baseTransparency = edgeFactor * 0.7
	orb.BackgroundTransparency = baseTransparency

	if edgeFactor > 0.15 then
		local c1, c2
		if baseColor == COLOR_WHITE then
			c1, c2 = COLOR_WHITE, Color3.fromRGB(210, 230, 255)
		elseif baseColor == COLOR_LIGHT_BLUE then
			c1, c2 = COLOR_LIGHT_BLUE, Color3.fromRGB(220, 240, 255)
		else
			c1, c2 = COLOR_PINK, Color3.fromRGB(255, 225, 235)
		end

		local gradient = Instance.new("UIGradient")
		gradient.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, c1),
			ColorSequenceKeypoint.new(0.5, c2),
			ColorSequenceKeypoint.new(1, c1),
		})
		local g1 = baseTransparency + 0.05
		local g2 = baseTransparency + 0.25
		local g3 = baseTransparency + 0.05
		gradient.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, math.clamp(g1, 0, 1)),
			NumberSequenceKeypoint.new(0.5, math.clamp(g2, 0, 1)),
			NumberSequenceKeypoint.new(1, math.clamp(g3, 0, 1)),
		})
		gradient.Rotation = math.random(0, 360)
		gradient.Parent = orb
		orb.BackgroundColor3 = baseColor
	else
		orb.BackgroundColor3 = tintColor(baseColor, 0.92)
	end

	orb.Parent = introGui
	table.insert(allOrbs, orb)

	local floatRange = forceEdge and 10 or 60
	local floatOffsetX = math.random(-floatRange, floatRange)
	local floatOffsetY = math.random(-floatRange, floatRange)
	local floatDuration = math.random(4, 8)

	local targetPos = UDim2.new(
		px + floatOffsetX / screenSize.X, 0,
		py + floatOffsetY / screenSize.Y, 0
	)

	local moveTween = TweenService:Create(
		orb,
		TweenInfo.new(floatDuration, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
		{ Position = targetPos }
	)
	moveTween:Play()
	table.insert(allTweens, moveTween)

	local floatRangeT = forceEdge and 0.05 or 0.2
	local targetTransparency = math.clamp(
		baseTransparency + (math.random() - 0.5) * 2 * floatRangeT, 0, 0.9
	)

	local fadeTween = TweenService:Create(
		orb,
		TweenInfo.new(math.random(3, 6), Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
		{ BackgroundTransparency = targetTransparency }
	)
	fadeTween:Play()
	table.insert(allTweens, fadeTween)

	local scaleFactor = isBig and 0.06 or 0.12
	local newSize = baseSize * (1 + scaleFactor)

	local breatheTween = TweenService:Create(
		orb,
		TweenInfo.new(math.random(2.5, 4.5), Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
		{ Size = UDim2.new(0, newSize, 0, newSize) }
	)
	breatheTween:Play()
	table.insert(allTweens, breatheTween)

	return orb
end

