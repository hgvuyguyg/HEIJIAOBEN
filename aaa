-- 3B. 随机球
local RANDOM_ORB_COUNT = 24
local function getRandomPosition()
	local region = math.random(1, 100)
	if region <= 35 then
		return math.random() * 0.22, 0.2 + math.random() * 0.8
	elseif region <= 70 then
		return 0.78 + math.random() * 0.22, 0.2 + math.random() * 0.8
	else
		return math.random(), 0.75 + math.random() * 0.25
	end
end

local bigCount = 0
for i = 1, RANDOM_ORB_COUNT do
	local isBig = false
	if bigCount < BIG_ORB_TARGET and (i <= BIG_ORB_TARGET or math.random() < 0.15) then
		isBig = true
		bigCount += 1
	end
	local px, py = getRandomPosition()
	local size = isBig and math.random(260, 400) or math.random(60, 160)
	createOrb(px, py, size, false, isBig)
end
while bigCount < BIG_ORB_TARGET do
	local px, py = getRandomPosition()
	createOrb(px, py, math.random(260, 400), false, true)
	bigCount += 1
end

