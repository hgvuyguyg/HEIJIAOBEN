-- ==================== 6. 时间线 ====================
task.spawn(function()
	task.wait(0.5)
	cursor.Visible = true

	local charCount = utf8.len(TEXT_CONTENT) or #TEXT_CONTENT
	local displayedText = ""

	for i = 1, charCount do
		local startByte = utf8.offset(TEXT_CONTENT, i)
		local endByte
		if i < charCount then
			endByte = utf8.offset(TEXT_CONTENT, i + 1) - 1
		else
			endByte = #TEXT_CONTENT
		end
		local char = string.sub(TEXT_CONTENT, startByte, endByte)
		displayedText = displayedText .. char
		textLabel.Text = displayedText
		measureLabel.Text = displayedText

		local textWidth = measureLabel.TextBounds.X
		local centerX = screenSize.X / 2
		local baseY = screenSize.Y * CENTER_Y + MAIN_OFFSET_Y
		cursor.Position = UDim2.new(0, centerX + textWidth / 2 + 6, 0, baseY)

		textLabel.TextTransparency = 0.35
		local popTween = TweenService:Create(
			textLabel,
			TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
			{ TextTransparency = 0 }
		)
		popTween:Play()
		task.wait(TYPE_SPEED)
	end

	for _ = 1, 2 do
		cursor.BackgroundTransparency = 1
		task.wait(0.15)
		cursor.BackgroundTransparency = 0
		task.wait(0.15)
	end
	cursor.Visible = false

	local enTween = TweenService:Create(
		enLabel, TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ TextTransparency = 0.25 }
	)
	local subTween = TweenService:Create(
		subLabel, TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ TextTransparency = 0.15 }
	)
	enTween:Play()
	subTween:Play()

	task.wait(0.3)

	-- 扫光
	local textWidth = measureLabel.TextBounds.X
	local centerX = screenSize.X / 2

	shineBar.Size = UDim2.new(0, 50, 0, 70)
	shineBar.Position = UDim2.new(0, centerX - textWidth / 2 - 40, CENTER_Y, MAIN_OFFSET_Y)
	shineBar.BackgroundTransparency = 0
	shineBar.Visible = true

	local scaleUp = TweenService:Create(
		textLabel, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ TextSize = 56 }
	)
	scaleUp:Play()

	local sweepTween = TweenService:Create(
		shineBar,
		TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut),
		{ Position = UDim2.new(0, centerX + textWidth / 2 + 40, CENTER_Y, MAIN_OFFSET_Y) }
	)
	sweepTween:Play()
	sweepTween.Completed:Wait()

	shineBar.Visible = false
	local scaleDown = TweenService:Create(
		textLabel, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ TextSize = 54 }
	)
	scaleDown:Play()

	task.wait(HOLD_TIME)

	-- 淡出
	local fadeTween = TweenService:Create(
		textLabel,
		TweenInfo.new(FADE_TIME, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ TextTransparency = 1, Position = UDim2.new(0.5, 0, CENTER_Y, MAIN_OFFSET_Y - 40) }
	)
	local fadeTween2 = TweenService:Create(
		enLabel,
		TweenInfo.new(FADE_TIME, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ TextTransparency = 1, Position = UDim2.new(0.5, 0, CENTER_Y, EN_OFFSET_Y - 40) }
	)
	local fadeTween3 = TweenService:Create(
		subLabel,
		TweenInfo.new(FADE_TIME, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ TextTransparency = 1, Position = UDim2.new(0.5, 0, CENTER_Y, SUB_OFFSET_Y - 40) }
	)
	fadeTween:Play()
	fadeTween2:Play()
	fadeTween3:Play()
	fadeTween.Completed:Wait()

	-- 球体淡出
	local orbFadeTasks = {}
	for _, orb in ipairs(allOrbs) do
		local fadeOut = TweenService:Create(
			orb,
			TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
			{ BackgroundTransparency = 1 }
		)
		fadeOut:Play()
		table.insert(orbFadeTasks, fadeOut)
	end
	for _, t in ipairs(orbFadeTasks) do
		t.Completed:Wait()
	end

	-- 白闪
	local flash = Instance.new("Frame")
	flash.Name = "Flash"
	flash.Size = UDim2.new(1, 0, 1, 0)
	flash.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	flash.BackgroundTransparency = 1
	flash.BorderSizePixel = 0
	flash.ZIndex = 200
	flash.Parent = introGui

	local flashIn = TweenService:Create(
		flash, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ BackgroundTransparency = 0.2 }
	)
	flashIn:Play()
	flashIn.Completed:Wait()
	task.wait(0.15)
	local flashOut = TweenService:Create(
		flash, TweenInfo.new(1.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ BackgroundTransparency = 1 }
	)
	flashOut:Play()
	flashOut.Completed:Wait()

	-- ==================== 7. 清理 ====================
	for _, t in ipairs(allTweens) do
		pcall(function() t:Cancel() end)
	end
	table.clear(allTweens)
	table.clear(allOrbs)

	if introGui and introGui.Parent then
		introGui:Destroy()
	end
end)
