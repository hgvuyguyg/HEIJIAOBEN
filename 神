                        f.Parent = p
                    end
                    local ang = tick() * 1.5 + (i * math.pi * 2 / cfg.FireCount)
                    p.Position = hrp.Position + Vector3.new(math.cos(ang) * cfg.FireRadius, -1, math.sin(ang) * cfg.FireRadius)
                end
            end
        else
            for i, p in pairs(fireParts) do pcall(function() p:Destroy() end) fireParts[i] = nil end
        end
    end)

    -- ============ 屏幕血雾 ============
    RunService.RenderStepped:Connect(function()
