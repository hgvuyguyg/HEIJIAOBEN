    aimConn = RunService.RenderStepped:Connect(function()
        safe(function()
            if not aimEnabled then return end
            local cam = workspace.CurrentCamera; if not cam then return end
            local t = findAimTarget()
            if t then local char = t.Character local part = char and getAimPart(char) if part then cam.CFrame = CFrame.new(cam.CFrame.Position, part.Position) end end
        end)
    end)
end
