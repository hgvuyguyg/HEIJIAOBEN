    -- ================= 强制第三人称（修好） =================
    local forceThird = false
    local forceThirdConn = nil
    local camLockApplied = false

    local function applyForceThird()
        local cam = Workspace.CurrentCamera
        if not cam then return end
        if not forceThird then
            if forceThirdConn then forceThirdConn:Disconnect(); forceThirdConn = nil end
            if camLockApplied then
                pcall(function()
                    player.CameraMode = Enum.CameraMode.Classic
                    player.CameraMinZoomDistance = 0.5
                    player.CameraMaxZoomDistance = 400
                    cam.CameraType = Enum.CameraType.Custom
                end)
                camLockApplied = false
            end
            return
        end

        -- 立刻应用
        pcall(function()
            player.CameraMode = Enum.CameraMode.Classic
            player.CameraMinZoomDistance = 12
            player.CameraMaxZoomDistance = 12
            cam.CameraMode = Enum.CameraMode.Classic
            cam.CameraType = Enum.CameraType.Custom
        end)
        camLockApplied = true

        -- 每帧强制压回
        if forceThirdConn then forceThirdConn:Disconnect() end
        forceThirdConn = RunService.RenderStepped:Connect(function()
            if not forceThird then return end
            local c = Workspace.CurrentCamera
            if not c then return end
            if c.CameraType == Enum.CameraType.FirstPerson then
                c.CameraType = Enum.CameraType.Custom
            end
            if c.CameraMode ~= Enum.CameraMode.Classic then
                c.CameraMode = Enum.CameraMode.Classic
            end
            if player.CameraMode ~= Enum.CameraMode.Classic then
                pcall(function() player.CameraMode = Enum.CameraMode.Classic end)
            end
            if player.CameraMinZoomDistance ~= 12 then
                pcall(function()
                    player.CameraMinZoomDistance = 12
                    player.CameraMaxZoomDistance = 12
                end)
            end
        end)
    end

