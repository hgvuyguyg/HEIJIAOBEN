                local fadeTween = TweenService:Create(img, TweenInfo.new(0.25, Enum.EasingStyle.Linear), {
                    ImageTransparency = 1
                })
                fadeTween:Play()
                
                TweenService:Create(stroke, TweenInfo.new(0.25), { Transparency = 1 }):Play()
                
                fadeTween.Completed:Connect(function()
                    if img and img.Parent then
                        img:Destroy()
                    end
                end)
            end
        end)
    end

    -- 监听点击
    UIS.InputBegan:Connect(function(input, gameProcessed)
        -- 🔑 【修改点】：这里去掉了 if gameProcessed then return end
