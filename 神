local function makeToolManager(toolName, builder, onActivated)
    local enabled, conn, watcher = false, nil, nil
    local function give()
        if not enabled then return end
        local bp = player:FindFirstChildOfClass("Backpack"); if not bp then return end
        local char = player.Character
        if bp:FindFirstChild(toolName) or (char and char:FindFirstChild(toolName)) then return end
        local tool = builder(); tool.Parent = bp
        if conn then pcall(function() conn:Disconnect() end) end
        conn = tool.Activated:Connect(function() if not enabled then return end pcall(onActivated, tool) end)
    end
    local function remove()
        local bp = player:FindFirstChildOfClass("Backpack"); if bp then local t = bp:FindFirstChild(toolName) if t then t:Destroy() end end
        local char = player.Character; if char then local t = char:FindFirstChild(toolName) if t then t:Destroy() end end
        if conn then pcall(function() conn:Disconnect() end) conn = nil end
    end
    local function startWatch()
        if watcher then return end
        watcher = task.spawn(function() while enabled do task.wait(0.5) pcall(give) end watcher = nil end)
    end
    player.CharacterAdded:Connect(function() if enabled then task.wait(0.5) give() end end)
    return { set = function(state) enabled = state if state then give() startWatch() else remove() end end }
end
