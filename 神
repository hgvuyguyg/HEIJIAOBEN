            if math.abs(Lighting.Brightness - targetBrightness) > 0.05 then
                Lighting.Brightness = targetBrightness
            end
            if Lighting.ClockTime ~= 0 then Lighting.ClockTime = 0 end
            if Lighting.Ambient ~= Color3.fromRGB(20, 0, 0) then Lighting.Ambient = Color3.fromRGB(20, 0, 0) end
            if Lighting.OutdoorAmbient ~= Color3.fromRGB(40, 5, 5) then Lighting.OutdoorAmbient = Color3.fromRGB(40, 5, 5) end
            if cfg.RedFog then
                if Lighting.FogColor ~= Color3.fromRGB(80, 0, 0) then Lighting.FogColor = Color3.fromRGB(80, 0, 0) end
