local function makeToggle(parent, opts)
    local row = new("Frame", {Size=UDim2.new(1,0,0,36), BackgroundColor3=WHITE_BG, BackgroundTransparency=0.4, BorderSizePixel=0, LayoutOrder=nextOrder(), Parent=parent}, {corner(6), stroke(WHITE_BG, 1, 0.5)})
    new("TextLabel", {Size=UDim2.new(1,-40,1,0), Position=UDim2.fromOffset(10,0), BackgroundTransparency=1, Text=opts.Title or "Toggle", TextColor3=TEXT_DARK, Font=Enum.Font.GothamMedium, TextSize=11, TextXAlignment=Enum.TextXAlignment.Left, Parent=row})
    local state = opts.Value or false
    local track = new("Frame", {Size=UDim2.fromOffset(32,18), Position=UDim2.new(1,-42,0.5,-9), BackgroundColor3=state and PRIMARY or Color3.fromRGB(190,200,210), BorderSizePixel=0, Parent=row}, {corner(9)})
    local knob = new("Frame", {Size=UDim2.fromOffset(14,14), Position=state and UDim2.new(1,-16,0.5,-7) or UDim2.fromOffset(2,2), BackgroundColor3=WHITE_BG, BorderSizePixel=0, Parent=track}, {corner(7)})
    local function set(v)
        safe(function()
            state = v
            TweenService:Create(track, TweenInfo.new(0.15), {BackgroundColor3=v and PRIMARY or Color3.fromRGB(190,200,210)}):Play()
            TweenService:Create(knob, TweenInfo.new(0.15), {Position=v and UDim2.new(1,-16,0.5,-7) or UDim2.fromOffset(2,2)}):Play()
            if opts.Callback then local ok, err = pcall(opts.Callback, v) if not ok then warn("[神脚本] Toggle callback 出错:", err) end end
        end)
    end
    local click = new("TextButton", {Size=UDim2.fromScale(1,1), BackgroundTransparency=1, Text="", Parent=row})
    click.MouseButton1Click:Connect(function() set(not state) end)
    if opts.Value == true and opts.Callback then
        task.defer(function() safe(function() local ok, err = pcall(opts.Callback, true) if not ok then warn("[神脚本] Toggle 初始化 callback 出错:", err) end end) end)
    end
    return row
end

