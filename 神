    -- ================= 除雾 / 彻底除雾（修好） =================
    local fogEnabled, totalFog = false, false
    local fogSaved = nil
    local fogConn = nil

    local function saveFog()
        if fogSaved then return end
        fogSaved = {
            FogStart = Lighting.FogStart,
            FogEnd = Lighting.FogEnd,
            FogColor = Lighting.FogColor,
            Atmosphere = {},
            Effects = {},
        }
        for _, v in ipairs(Lighting:GetChildren()) do
            if v:IsA("Atmosphere") then
                table.insert(fogSaved.Atmosphere, {obj = v, Density = v.Density, Haze = v.Haze})
            end
            if v:IsA("BlurEffect") then
                table.insert(fogSaved.Effects, {obj = v, prop = "Size", val = v.Size})
            end
            if v:IsA("SunRaysEffect") then
                table.insert(fogSaved.Effects, {obj = v, prop = "Intensity", val = v.Intensity})
            end
        end
    end
    local function restoreFog()
        if not fogSaved then return end
        pcall(function()
            Lighting.FogStart = fogSaved.FogStart
            Lighting.FogEnd = fogSaved.FogEnd
            Lighting.FogColor = fogSaved.FogColor
        end)
        for _, d in ipairs(fogSaved.Atmosphere) do
            pcall(function() d.obj.Density = d.Density; d.obj.Haze = d.Haze end)
        end
        for _, d in ipairs(fogSaved.Effects) do
            pcall(function() d.obj[d.prop] = d.val end)
        end
        fogSaved = nil
    end

    local function refreshFog()
        if not fogEnabled then return end
        Lighting.FogEnd = 1e7
        Lighting.FogStart = 1e7
        for _, v in ipairs(Lighting:GetChildren()) do
            if v:IsA("Atmosphere") then
                v.Density = 0
                if totalFog then v.Haze = 0 end
            end
            if totalFog then
                if v:IsA("BlurEffect") then v.Size = 0 end
                if v:IsA("SunRaysEffect") then v.Intensity = 0 end
            end
        end
    end

    makeTitle("【 除雾 】")
    makeToggle("🌫️ 除雾", function(s)
        fogEnabled = s
        if fogConn then fogConn:Disconnect(); fogConn = nil end
        if s then
            saveFog()
            refreshFog()
            fogConn = RunService.RenderStepped:Connect(function()
                if fogEnabled then refreshFog() end
            end)
        else
