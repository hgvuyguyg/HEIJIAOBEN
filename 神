                    p.LocalTransparencyModifier = 0.55
                end
            end
        else
            for p, t in pairs(ghostSaved) do
                if p and p.Parent then pcall(function() p.LocalTransparencyModifier = t end) end
            end
            ghostSaved = {}
        end
    end
