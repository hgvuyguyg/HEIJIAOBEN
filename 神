    effectGui.DisplayOrder = 2147483647 -- 保证在最顶层，脚本面板也盖不住它
    effectGui.Parent = parentTarget

    local IMAGE_ID = "rbxassetid://262531136"

    local function spawnClickImage(screenPos)
        local img = Instance.new("ImageLabel")
        img.AnchorPoint = Vector2.new(0.5, 0.5)
        
        local vpSize = camera.ViewportSize
        img.Position = UDim2.new(screenPos.X / vpSize.X, 0, screenPos.Y / vpSize.Y, 0)
        
        -- 【更小】初始大小调为 8x8，弹出到 18x18
        img.Size = UDim2.fromOffset(8, 8) 
        img.BackgroundTransparency = 1
        img.Image = IMAGE_ID
        img.ScaleType = Enum.ScaleType.Fit
        img.ImageTransparency = 0
        img.Parent = effectGui

        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(1, 0)
        corner.Parent = img
        
        local stroke = Instance.new("UIStroke")
        stroke.Thickness = 1.5 -- 边框更细
        stroke.Transparency = 0
        stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
        stroke.Parent = img

        -- 彩虹闪烁边框协程
        local isFading = false
        local startTime = tick()
        local rainbowConn
        rainbowConn = RunService.RenderStepped:Connect(function()
            if isFading or not stroke or not stroke.Parent then return end
            local t = tick() - startTime
            stroke.Color = Color3.fromHSV((t * 0.8) % 1, 1, 1)
            stroke.Transparency = 0.5 + 0.4 * math.sin(t * 15)
        end)

        -- 弹出动画：弹到 18x18
        TweenService:Create(img, TweenInfo.new(0.15, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Size = UDim2.fromOffset(18, 18)
        }):Play()

        -- 停留 0.6 秒后开始极速淡出
        task.delay(0.6, function()
