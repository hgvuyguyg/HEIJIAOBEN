-- 🌈 一次性末尾补丁：彩虹边框（窗口+悬浮球）+ 精确移除颜色选择
-- =========================================================
task.spawn(function()
    local n9 = playerGui:WaitForChild("N9Hub", 10)
    if not n9 then return end

    local win = n9:WaitForChild("MainWindow", 10)
    local openBtn = n9:WaitForChild("OpenButton", 10)
    if not win or not openBtn then return end

    -- ===== 1) 精确清理设置里的「UI 边框颜色」选择 =====
    local realContent = nil
    for _, c in ipairs(win:GetChildren()) do
        if c:IsA("ScrollingFrame") and c.Position.X.Offset == 90 then realContent = c break end
    end
    if realContent then
        -- 只找"标题文本 == UI 边框颜色"的那个 Frame 卡片，删它自己
        local targets = {}
        for _, d in ipairs(realContent:GetDescendants()) do
            if d:IsA("TextLabel") and d.Text == "UI 边框颜色" then
                local card = d.Parent
                if card and card:IsA("Frame") then
                    targets[card] = true
                end
            end
        end
        for card in pairs(targets) do
            -- 只删这个卡片内的东西，不碰兄弟行
            local page = card.Parent
            -- 若之前有旧补丁在旁边建了展开区，它在 page 里且 LayoutOrder 紧随，但为避免误删，这里用名字/结构判断：
            -- 只有"空高度(Size.Y.Offset==0 或 Visible==false) 且 内部含 ScrollingFrame 列表"的才算展开区
            if page then
                for _, sib in ipairs(page:GetChildren()) do
                    if sib ~= card and sib:IsA("Frame") then
                        local hasList = false
                        for _, cc in ipairs(sib:GetDescendants()) do
                            if cc:IsA("ScrollingFrame") then hasList = true break end
                        end
                        -- 只有"含滚动列表"且"高度为0或不可见"的兄弟才判为展开区，且它必须紧邻(±1)
                        local closeOrder = false
                        if card.LayoutOrder and sib.LayoutOrder then
                            closeOrder = (sib.LayoutOrder == card.LayoutOrder + 1) or (sib.LayoutOrder == card.LayoutOrder - 1)
                        end
                        if hasList and closeOrder and (sib.Size.Y.Offset == 0 or sib.Visible == false) then
                            pcall(function() sib:Destroy() end)
                        end
                    end
                end
            end
            pcall(function() card:Destroy() end)
        end
    end

    -- ===== 2) 窗口 + 悬浮球彩虹边框 =====
    local winStroke = win:FindFirstChildOfClass("UIStroke")
    if not winStroke then
        winStroke = Instance.new("UIStroke")
        winStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
        winStroke.Parent = win
    end
    winStroke.Thickness = 2

    local ballStroke = openBtn:FindFirstChildOfClass("UIStroke")
    if not ballStroke then
        ballStroke = Instance.new("UIStroke")
        ballStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
        ballStroke.Parent = openBtn
    end
    ballStroke.Thickness = 1.8

    local t = 0
    RunService.RenderStepped:Connect(function(dt)
        t = t + dt
        local hue = (t * 0.35) % 1
        local col = Color3.fromHSV(hue, 1, 1)
        local trans = 0.35 + 0.3 * math.sin(t * 8)

        if winStroke and winStroke.Parent then
            winStroke.Color = col
            winStroke.Transparency = trans
        end
        if ballStroke and ballStroke.Parent and openBtn.Visible then
            ballStroke.Color = col
            ballStroke.Transparency = trans
        end
    end)
end)
