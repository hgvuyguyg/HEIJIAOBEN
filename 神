local function makeSlider(parent, opts)
    local min, max, value = opts.Min or 0, opts.Max or 100, opts.Default or 0
    local row = new("Frame", {Size=UDim2.new(1,0,0,50), BackgroundColor3=WHITE_BG, BackgroundTransparency=0.4, BorderSizePixel=0, LayoutOrder=nextOrder(), Parent=parent}, {corner(6), stroke(WHITE_BG, 1, 0.5), padding(10)})
    new("TextLabel", {Size=UDim2.new(1,-50,0,16), BackgroundTransparency=1, Text=opts.Title or "Slider", TextColor3=TEXT_DARK, Font=Enum.Font.GothamMedium, TextSize=11, TextXAlignment=Enum.TextXAlignment.Left, Parent=row})
    local valueLabel = new("TextLabel", {Size=UDim2.fromOffset(50,16), Position=UDim2.new(1,-50,0,0), BackgroundTransparency=1, Text=tostring(value), TextColor3=PRIMARY, Font=Enum.Font.GothamBold, TextSize=11, TextXAlignment=Enum.TextXAlignment.Right, Parent=row})
    local track = new("Frame", {Size=UDim2.new(1,0,0,6), Position=UDim2.new(0,0,1,-10), BackgroundColor3=Color3.fromRGB(200,205,215), BorderSizePixel=0, Parent=row}, {corner(3)})
    local rel = (value - min) / math.max(max - min, 1)
    local fill = new("Frame", {Size=UDim2.new(rel,0,1,0), BackgroundColor3=PRIMARY, BorderSizePixel=0, Parent=track}, {corner(3)})
    local knob = new("Frame", {Size=UDim2.fromOffset(14,14), AnchorPoint=Vector2.new(0.5,0.5), Position=UDim2.new(rel,0,0.5,0), BackgroundColor3=WHITE_BG, BorderSizePixel=0, ZIndex=2, Parent=track}, {corner(7), stroke(PRIMARY, 2, 0)})
    local hit = new("TextButton", {Size=UDim2.new(1,0,0,24), Position=UDim2.new(0,0,1,-24), BackgroundTransparency=1, Text="", ZIndex=3, Parent=row})
    local dragging = false
    local function updateFromX(x)
        safe(function()
            local r = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
            local v = math.floor(min + (max - min) * r + 0.5)
            fill.Size = UDim2.new(r,0,1,0)
            knob.Position = UDim2.new(r,0,0.5,0)
            valueLabel.Text = tostring(v)
            if opts.Callback then local ok, err = pcall(opts.Callback, v) if not ok then warn("[神脚本] Slider callback 出错:", err) end end
        end)
    end
    hit.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            updateFromX(input.Position.X)
        end
    end)
    UIS.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            updateFromX(input.Position.X)
        end
    end)
    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    return row
end

