    local lightningTask, flashTask, bloodDropTask
    local ghostSaved = {}

    -- ============ 恐怖光照（每帧维持，防止被游戏重置） ============
    local function applyHorror()
        if not cfg.Horror then
            restoreLighting()
            return
        end
        saveLighting()
        if lightningTask then task.cancel(lightningTask); lightningTask = nil end
        if cfg.Lightning then
            lightningTask = task.spawn(function()
                while cfg.Horror and cfg.Lightning do
                    task.wait(math.random(3, 8))
                    if not cfg.Horror or not cfg.Lightning then break end
                    local orig = Lighting.Brightness
                    Lighting.Brightness = 3
                    task.wait(0.05)
                    Lighting.Brightness = orig
                    task.wait(0.08)
                    Lighting.Brightness = 3
                    task.wait(0.05)
                    Lighting.Brightness = orig
                end
            end)
        end
    end

    -- 每帧强制维持恐怖光照
    RunService.RenderStepped:Connect(function()
        if cfg.Horror then
