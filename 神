local tabs, activeTab, tabOrder = {}, nil, 0
local function createTab(name, icon)
    tabOrder = tabOrder + 1
    local btn = new("TextButton", {
        Name="Tab_"..name, Size=UDim2.new(1,0,0,28), BackgroundTransparency=1,
        Text="  "..(icon and (icon.."  ") or "")..name, TextColor3=TEXT_DARK, Font=Enum.Font.GothamMedium, TextSize=11,
        TextXAlignment=Enum.TextXAlignment.Left, AutoButtonColor=false, LayoutOrder=tabOrder, ZIndex=3, Parent=sidebar,
    }, {corner(6), padding(4), new("Frame", {Name="Indicator", Size=UDim2.new(0,2,0,0), Position=UDim2.new(0,-4,0.5,0), AnchorPoint=Vector2.new(0,0.5), BackgroundColor3=PRIMARY, BorderSizePixel=0, ZIndex=4}, {corner(2)})})
    
    local page = new("Frame", {Name="Page_"..name, Size=UDim2.new(1,0,0,0), AutomaticSize=Enum.AutomaticSize.Y, BackgroundTransparency=1, Visible=false, LayoutOrder=tabOrder, Parent=content}, {new("UIListLayout", {Padding=UDim.new(0,8), SortOrder=Enum.SortOrder.LayoutOrder})})
    
    tabs[name] = {button=btn, page=page}
    btn.MouseEnter:Connect(function() safe(function() if activeTab ~= name then TweenService:Create(btn, TweenInfo.new(0.15), {TextColor3=PRIMARY}):Play() end end) end)
    btn.MouseLeave:Connect(function() safe(function() if activeTab ~= name then TweenService:Create(btn, TweenInfo.new(0.15), {TextColor3=TEXT_DARK}):Play() end end) end)
    btn.MouseButton1Click:Connect(function()
        safe(function()
            for n, t in pairs(tabs) do
                if n == name then
                    t.page.Visible = true
                    t.button.TextColor3 = PRIMARY
                    TweenService:Create(t.button.Indicator, TweenInfo.new(0.2), {Size=UDim2.new(0,2,0,16)}):Play()
                    activeTab = name
                else
                    t.page.Visible = false
                    t.button.TextColor3 = TEXT_DARK
                    TweenService:Create(t.button.Indicator, TweenInfo.new(0.2), {Size=UDim2.new(0,2,0,0)}):Play()
                end
            end
        end)
    end)
    return page
end

