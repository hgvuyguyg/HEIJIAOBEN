    -- 静默甩飞/循环甩飞的启停逻辑
    local function applySilent(state)
        isSilentFlyEnabled = state
        for _, conn in pairs(flyConnections) do pcall(function() conn:Disconnect() end) end
        flyConnections = {}
        if state then
            local c1 = RunService.Stepped:Connect(function()
                if not isSilentFlyEnabled then return end
                local char = Player.Character
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                if hum and hrp then
                    pcall(function()
                        hum.PlatformStand = false; hum.Sit = false; hum.AutoRotate = true
                        local st = hum:GetState()
                        if st == Enum.HumanoidStateType.Physics or st == Enum.HumanoidStateType.FallingDown or st == Enum.HumanoidStateType.Ragdoll then
                            hum:ChangeState(Enum.HumanoidStateType.GettingUp)
                        end
                    end)
                end
                if isSilentFlyEnabled then
                    for _, op in ipairs(Players:GetPlayers()) do
                        if op ~= Player then
                            local oc = op.Character
                            if oc then
                                for _, part in ipairs(oc:GetDescendants()) do
                                    if part:IsA("BasePart") then pcall(function() part.CanCollide = false end) end
                                end
                            end
                        end
                    end
                end
            end)
            table.insert(flyConnections, c1)
            local c2 = RunService.Heartbeat:Connect(function()
                if not isSilentFlyEnabled then return end
                local char = Player.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                if hum and hrp then
                    pcall(function()
                        local v = hrp.AssemblyLinearVelocity
                        hum:ChangeState(Enum.HumanoidStateType.Running)
                        local sy = math.clamp(v.Y, -40, 40)
                        hrp.AssemblyAngularVelocity = Vector3.new(50000,50000,50000)
                        hrp.AssemblyLinearVelocity = Vector3.new(v.X*1.1, sy, v.Z*1.1)
                        RunService.RenderStepped:Wait()
                        if hrp and hrp.Parent then hrp.AssemblyAngularVelocity = Vector3.new(0,0,0) end
                    end)
                end
            end)
            table.insert(flyConnections, c2)
        end
        silentBtn.Text = state and "🔇 静默甩飞 ON" or "🔇 静默甩飞 OFF"
        silentBtn.BackgroundColor3 = state and Color3.fromRGB(200,0,0) or Color3.fromRGB(0,180,0)
    end

    silentBtn.MouseButton1Click:Connect(function()
        applySilent(not isSilentFlyEnabled)
    end)

    local function stopLoop()
        isLoopFlyEnabled = false
        for _, conn in pairs(loopFlyConnections) do pcall(function() conn:Disconnect() end) end
        loopFlyConnections = {}
        loopBtn.Text = "🔄 循环甩飞 OFF"
        loopBtn.BackgroundColor3 = Color3.fromRGB(0,180,0)
        local myHrp = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
        if myHrp and originalPosition then
            myHrp.Position = originalPosition
            myHrp.AssemblyAngularVelocity = Vector3.new(0,0,0)
            myHrp.AssemblyLinearVelocity = Vector3.new(0,0,0)
        end
        loopTargetPlayer = nil
        originalPosition = nil
        if not wasSilentBefore then applySilent(false) end
        updateStaticStatus("⏸️ 已停止", nil)
    end

    loopBtn.MouseButton1Click:Connect(function()
        if isLoopFlyEnabled then
            stopLoop()
            return
        end
        if not selectedStatic then updateStaticStatus("⚠️ 未选择玩家", false) return end
        local tChar = selectedStatic.Character
        if not tChar then updateStaticStatus("⚠️ 目标不在游戏中", false) return end
        if not tChar:FindFirstChild("HumanoidRootPart") then updateStaticStatus("⚠️ 目标无角色", false) return end
        local myHrp = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
        if not myHrp then return end

        isLoopFlyEnabled = true
        loopTargetPlayer = selectedStatic
        originalPosition = myHrp.Position
        wasSilentBefore = isSilentFlyEnabled
        if not isSilentFlyEnabled then applySilent(true) end
        loopBtn.Text = "🔄 循环甩飞 ON"
        loopBtn.BackgroundColor3 = Color3.fromRGB(200,0,0)
        updateStaticStatus("🔄 循环甩飞中...", nil)

        local c = RunService.Heartbeat:Connect(function()
            if not isLoopFlyEnabled then return end
            local curChar = loopTargetPlayer and loopTargetPlayer.Character
            if not curChar then stopLoop(); return end
            local curHrp = curChar:FindFirstChild("HumanoidRootPart")
            if not curHrp then return end
            local dir = math.sin(tick() * 6)
            local myHrp2 = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
            if myHrp2 then
                myHrp2.CFrame = CFrame.new(curHrp.Position + curHrp.CFrame.LookVector * (dir * 2.5))
            end
            local vel = curHrp.AssemblyLinearVelocity.Magnitude
            local hum = curChar:FindFirstChildOfClass("Humanoid")
            local st = hum and hum:GetState()
            if vel > 30 or (st and (st == Enum.HumanoidStateType.Physics or st == Enum.HumanoidStateType.FallingDown or st == Enum.HumanoidStateType.Ragdoll)) then
                updateStaticStatus("🟢 已甩飞该玩家", true)
            else
                updateStaticStatus("🔴 甩飞无效", false)
            end
        end)
        table.insert(loopFlyConnections, c)

        local leaveConn = Players.PlayerRemoving:Connect(function(plr)
            if plr == loopTargetPlayer and isLoopFlyEnabled then stopLoop() end
        end)
        table.insert(loopFlyConnections, leaveConn)
    end)

    Players.PlayerAdded:Connect(function() task.wait(0.5) refreshStaticList() end)
    Players.PlayerRemoving:Connect(function(plr)
        if selectedStatic == plr then selectedStatic = nil end
        task.wait(0.2); refreshStaticList()
    end)
    refreshStaticList()
end)
